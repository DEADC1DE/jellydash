<div class="empty-state">
    <div class="empty-orbit" aria-hidden="true">
        <span></span>
        <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false">
            <path d="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-5 2.66a1 1 0 0 0 -.993 .883l-.007 .117v5l.009 .131a1 1 0 0 0 .197 .477l.087 .1l3 3l.094 .082a1 1 0 0 0 1.226 0l.094 -.083l.083 -.094a1 1 0 0 0 0 -1.226l-.083 -.094l-2.707 -2.708v-4.585l-.007 -.117a1 1 0 0 0 -.993 -.883z"></path>
        </svg>
    </div>
    {% if summary.total == 0 %}
        <h2>No plays yet</h2>
        <p>Jellydash records new plays automatically. If you already used Playback Reporting, you can bring that history with you.</p>
        <a class="empty-state-action" href="/settings#import-history">Import existing history</a>
    {% else %}
        <h2>No plays match your filters</h2>
        <p>Try clearing the search or choosing all users.</p>
    {% endif %}
</div>
