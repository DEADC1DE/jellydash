{% set active_page = layout.page|default('now-playing') %}
{% set has_nav_count = streams is defined and not is_loading|default(false) %}

<aside class="dashboard-sidebar" id="dashboard-sidebar">
    <a class="brand" href="/now-playing" aria-label="Jellydash">
        <span class="brand-mark" aria-hidden="true">
            <img src="/assets/img/jellydash_logo.png" alt="">
        </span>
        <span>
            <strong>Jellydash</strong>
            {% if server_label %}<small>{{ server_label }}</small>{% endif %}
        </span>
    </a>

    <nav class="dashboard-nav" aria-label="Dashboard">
        <span class="nav-section">Monitor</span>

        <a class="nav-item {{ active_page == 'now-playing' ? 'is-active' : '' }}" href="/now-playing">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M8 5v14l11-7-11-7z"></path>
                </svg>
            </span>
            <span>Now Playing</span>
            <span class="nav-pill {{ has_nav_count ? '' : 'is-loading' }}" data-nav-count>{{ has_nav_count ? streams|length : '' }}</span>
        </a>

        {% for item in module_nav %}
            <a class="nav-item {{ active_page == item.route ? 'is-active' : '' }}" href="/{{ item.route }}">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img" focusable="false">{{ item.icon|raw }}</svg>
                </span>
                <span>{{ item.label }}</span>
            </a>
        {% endfor %}

        {% if seerr_enabled %}
        <a class="nav-item {{ active_page == 'jellyseerr' ? 'is-active' : '' }}" href="/jellyseerr">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M12 4.5l2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L4.8 9.8l5-.7z"></path>
                </svg>
            </span>
            <span>Jellyseerr</span>
        </a>
        {% endif %}

        <a class="nav-item {{ active_page == 'history' ? 'is-active' : '' }}" href="/history">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M12 7v5l3 2"></path>
                    <path d="M21 12a9 9 0 1 1-3.2-6.9"></path>
                </svg>
            </span>
            <span>History</span>
        </a>

        <a class="nav-item {{ active_page == 'statistics' ? 'is-active' : '' }}" href="/statistics">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M5 20V10"></path>
                    <path d="M12 20V4"></path>
                    <path d="M19 20v-7"></path>
                </svg>
            </span>
            <span>Statistics</span>
        </a>

        <a class="nav-item {{ active_page == 'libraries' ? 'is-active' : '' }}" href="/libraries">
            <span class="nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H11v14H6.5A2.5 2.5 0 0 0 4 20.5v-14z"></path>
                    <path d="M20 6.5A2.5 2.5 0 0 0 17.5 4H13v14h4.5A2.5 2.5 0 0 1 20 20.5v-14z"></path>
                </svg>
            </span>
            <span>Libraries</span>
        </a>
    </nav>

    <div class="sidebar-spacer"></div>

    <section class="server-card" aria-label="Server status" data-server-card>
        <div class="server-card-header">
            <span>Server</span>
            <strong><span class="status-dot"></span><span data-server-status>Checking</span></strong>
        </div>
        <div class="server-meter">
            <span>CPU</span>
            <div class="meter-track"><span style="width: 0%" data-server-cpu-bar></span></div>
            <b data-server-cpu>...</b>
        </div>
        <div class="server-meter">
            <span>RAM</span>
            <div class="meter-track meter-track-blue"><span style="width: 0%" data-server-ram-bar></span></div>
            <b data-server-ram>...</b>
        </div>
    </section>

    {% if push_enabled and vapid_public_key %}
        <button class="settings-row push-row" type="button" data-push-toggle aria-pressed="false" hidden>
            <span class="settings-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.7 21a2 2 0 0 1-3.4 0"></path>
                </svg>
            </span>
            <span>
                <strong>Notifications</strong>
                <small data-push-state>Off</small>
            </span>
        </button>
    {% endif %}

    <a class="settings-row {{ active_page == 'settings' ? 'is-active' : '' }}" href="/settings" aria-label="Settings">
        <span class="settings-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false">
                <path d="M12 8.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7z"></path>
                <path d="M19 12a7.3 7.3 0 0 0-.1-1l2-1.5-2-3.4-2.4 1a7.1 7.1 0 0 0-1.8-1L14.4 3h-4.8l-.3 3.1a7.1 7.1 0 0 0-1.8 1l-2.4-1-2 3.4L5.1 11a7.3 7.3 0 0 0 0 2l-2 1.5 2 3.4 2.4-1a7.1 7.1 0 0 0 1.8 1l.3 3.1h4.8l.3-3.1a7.1 7.1 0 0 0 1.8-1l2.4 1 2-3.4-2-1.5c.1-.3.1-.7.1-1z"></path>
            </svg>
        </span>
        <span>
            <strong>Settings</strong>
            <small>Jellydash v{{ app_version }}</small>
        </span>
    </a>

    {% if auth_enabled and layout.user %}
        <form class="logout-form" action="?auth=logout" method="post">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <button type="submit" class="settings-row logout-row">
                <span class="settings-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img" focusable="false">
                        <path d="M9 4H5.5A1.5 1.5 0 0 0 4 5.5v13A1.5 1.5 0 0 0 5.5 20H9"></path>
                        <path d="M15 8l4 4-4 4"></path>
                        <path d="M19 12H9"></path>
                    </svg>
                </span>
                <span>
                    <strong>Sign out</strong>
                    <small>{{ layout.user.name|default(layout.user.username) }}</small>
                </span>
            </button>
        </form>
    {% endif %}
</aside>
