<dialog class="release-dialog" data-release-dialog aria-labelledby="release-dialog-title" aria-describedby="release-dialog-summary">
    <section class="release-dialog-card">
        <button class="release-dialog-close" type="button" data-release-close aria-label="Close What's new">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 6l12 12"></path>
                <path d="M18 6L6 18"></path>
            </svg>
        </button>

        <span class="release-dialog-kicker" data-release-version></span>
        <h2 id="release-dialog-title" data-release-title></h2>
        <p id="release-dialog-summary" class="release-dialog-summary" data-release-summary></p>
        <ul class="release-dialog-highlights" data-release-highlights></ul>

        <div class="release-dialog-links" data-release-links></div>

        <button class="release-dialog-dismiss" type="button" data-release-close>Close</button>
    </section>
</dialog>
