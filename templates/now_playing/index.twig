{% extends "_shell.twig" %}

{% block dashboard_header %}
    <div class="header-copy">
        <h1>Now Playing</h1>
        <p><span class="live-dot {{ streams|length > 0 ? 'is-live' : 'is-idle' }}" data-live-dot></span><span data-live-label>{{ is_loading|default(false) ? 'Loading sessions...' : (streams|length > 0 ? streams|length ~ ' ' ~ (streams|length == 1 ? 'stream' : 'streams') ~ ' - ' ~ stats.active_users ~ ' ' ~ (stats.active_users == 1 ? 'user' : 'users') : 'No active sessions') }}</span></p>
    </div>
{% endblock %}

{% block dashboard_content %}
    <div class="now-playing-page" data-now-playing-page>
        <div class="now-playing-live{{ streams is not empty ? ' has-streams' : '' }}" data-now-playing-root>
            {% if is_loading|default(false) %}
                {% include "now_playing/_loading.twig" %}
            {% elseif streams is empty %}
                {% include "now_playing/_empty.twig" %}
            {% else %}
                <div class="stream-grid">
                    {% for stream in streams %}
                        {% include "now_playing/_stream_card.twig" with { stream: stream } %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <section class="recently-added-panel" data-recently-added aria-labelledby="recently-added-title" hidden>
            <header class="recently-added-header">
                <span class="recently-added-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img" focusable="false">
                        <path d="M12 3v4"></path>
                        <path d="M12 17v4"></path>
                        <path d="M3 12h4"></path>
                        <path d="M17 12h4"></path>
                        <path d="m6.4 6.4 2.2 2.2"></path>
                        <path d="m15.4 15.4 2.2 2.2"></path>
                        <path d="m17.6 6.4-2.2 2.2"></path>
                        <path d="m8.6 15.4-2.2 2.2"></path>
                        <circle cx="12" cy="12" r="2.7"></circle>
                    </svg>
                </span>
                <div>
                    <h2 id="recently-added-title">Recently Added</h2>
                    <p>Fresh from Jellyfin</p>
                </div>
                <span class="recently-added-window" data-recently-added-window>Last 14 days</span>
            </header>
            <div class="recently-added-row" data-recently-added-row tabindex="0" aria-label="Recently added media"></div>
        </section>
    </div>
{% endblock %}

{% block dashboard_footer %}
    <div class="stat-cell">
        <span><i class="dot-purple"></i>Watch time today</span>
        <strong data-stat="watch_today">{{ stats.watch_today }}</strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-green"></i>Active streams</span>
        <strong data-stat-block="active_streams">
            {% if stats.active_streams > 0 %}
                <span>{{ stats.active_streams }}</span> <small>{{ stats.active_streams == 1 ? 'stream' : 'streams' }}</small>
            {% else %}
                <span class="stat-placeholder">Idle</span>
            {% endif %}
        </strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-blue"></i>Bandwidth in use</span>
        <strong data-stat-block="bandwidth">
            {% if stats.active_streams > 0 %}
                <span>{{ stats.bandwidth_mbps }}</span> <small>Mbps</small>
            {% else %}
                <span class="stat-placeholder">Idle</span>
            {% endif %}
        </strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-amber"></i>Transcoding</span>
        <strong data-stat-block="transcoding">
            {% if stats.active_streams > 0 %}
                <span>{{ stats.transcodes }}</span> <small>of {{ stats.active_streams }} streams</small>
            {% else %}
                <span class="stat-placeholder">None</span>
            {% endif %}
        </strong>
    </div>
{% endblock %}

{% block page_scripts %}
    <script src="/assets/js/now-playing.js?v=20260818-correctness"></script>
    <script src="/assets/js/recently-added.js?v=20260818-compact-recently-added"></script>
{% endblock %}
