{% extends "_shell.twig" %}

{% block dashboard_header %}
    <div class="header-copy">
        <h1>Stream Rules</h1>
        <p>{{ rules|length }} rule{{ rules|length == 1 ? '' : 's' }} · checked on every poll cycle</p>
    </div>
{% endblock %}

{% block dashboard_content %}
    {% if message %}<div class="settings-saved" role="status">{{ message }}</div>{% endif %}
    {% if error %}<div class="settings-error" role="alert">{{ error }}</div>{% endif %}

    <header class="stats-section-header">
        <strong>Rules</strong>
        <span>Matching live sessions are stopped or kicked automatically</span>
        <i></i>
    </header>

    <div class="stream-rules-list">
        {% for rule in rules %}
            <article class="stream-rule{{ rule.enabled ? '' : ' is-disabled' }}">
                <div class="stream-rule-main">
                    <strong class="stream-rule-name">{{ rule.name }}</strong>
                    <div class="stream-rule-conditions">
                        {% if rule.logic %}<code class="stream-rule-logic">{{ rule.logic }}</code>{% endif %}
                        {% for condition in rule.conditions %}
                            {% if condition.parameter and condition.operator %}
                                <span class="stream-rule-condition">
                                    <b>{{ condition.parameter }}</b> {{ condition.operator }} <i>{{ condition.value ?: '~' }}</i>
                                </span>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
                <div class="stream-rule-side">
                    <span class="stream-rule-action">{{ actions[rule.action] ?? rule.action }}</span>
                    <span class="stream-rule-kills">{{ rule.kill_count }} kill{{ rule.kill_count == 1 ? '' : 's' }}</span>
                    <a class="stream-rule-toggle" href="/session-rules?edit={{ rule.id }}">Edit</a>
                    <form method="post">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="do" value="toggle">
                        <input type="hidden" name="id" value="{{ rule.id }}">
                        <button class="stream-rule-toggle" type="submit">{{ rule.enabled ? 'Disable' : 'Enable' }}</button>
                    </form>
                    <form method="post">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="do" value="delete">
                        <input type="hidden" name="id" value="{{ rule.id }}">
                        <button class="stream-rule-delete" type="submit">Delete</button>
                    </form>
                </div>
            </article>
        {% else %}
            <div class="stream-rule-empty">No rules yet. Add one below — e.g. kill every transcode, or cap streams per user.</div>
        {% endfor %}
    </div>

    <header class="stats-section-header" id="editor">
        <strong>{{ edit ? 'Edit rule #' ~ edit.id : 'Add rule' }}</strong>
        <span>Blank condition rows are skipped · values may be comma-separated (any of them matches)</span>
        <i></i>
    </header>

    <section class="stream-rule-editor">
        <form method="post">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="do" value="save">
            <input type="hidden" name="id" value="{{ edit ? edit.id : 0 }}">

            <div class="stream-rule-editor-grid">
                <label class="stream-rule-field stream-rule-field-name">
                    <span>Rule name</span>
                    <input type="text" name="name" value="{{ edit ? edit.name : '' }}" placeholder="No transcodes" required>
                </label>
                <label class="stream-rule-field">
                    <span>On match</span>
                    <select name="action">
                        {% for key, label in actions %}
                            <option value="{{ key }}"{{ (edit ? edit.action : 'stop') == key ? ' selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="stream-rule-field stream-rule-field-logic">
                    <span>Logic (blank = all rows must match)</span>
                    <input type="text" name="logic" value="{{ edit ? edit.logic : '' }}" placeholder="{1} and ({2} or {3})">
                </label>
            </div>

            {% for slot in 1..maxConditions %}
                {% set condition = edit ? (edit.conditions[slot - 1] ?? null) : null %}
                <div class="stream-rule-editor-grid stream-rule-condition-row">
                    <label class="stream-rule-field">
                        <span>Condition {{ slot }} — field</span>
                        <select name="parameter_{{ slot }}">
                            <option value="">— none —</option>
                            {% for key, label in parameters %}
                                <option value="{{ key }}"{{ condition and condition.parameter == key ? ' selected' : '' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label class="stream-rule-field">
                        <span>Operator</span>
                        <select name="operator_{{ slot }}">
                            {% for operator in operators %}
                                <option value="{{ operator }}"{{ condition and condition.operator == operator ? ' selected' : '' }}>{{ operator }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label class="stream-rule-field stream-rule-field-value">
                        <span>Value (~ = empty, comma = any of)</span>
                        <input type="text" name="value_{{ slot }}" value="{{ condition ? condition.value : '' }}" placeholder="transcode, direct">
                    </label>
                </div>
            {% endfor %}

            <div class="stream-rule-editor-actions">
                <button class="stream-rule-save" type="submit">{{ edit ? 'Save changes' : 'Add rule' }}</button>
                {% if edit %}<a class="stream-rule-cancel" href="/session-rules">Cancel</a>{% endif %}
            </div>        </form>
    </section>
{% endblock %}
