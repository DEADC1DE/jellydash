{% extends "_shell.twig" %}

{% block dashboard_header %}
    <div class="header-copy">
        <h1>Server Health</h1>
        <p>{{ info.serverName }} — Jellyfin {{ info.version }} ({{ info.operatingSystem }})</p>
    </div>
{% endblock %}

{% block dashboard_content %}
    <div class="health-tasks-table">
        <div class="health-tasks-head">
            <span>Task</span>
            <span>State</span>
            <span>Progress</span>
            <span>Last run</span>
            <span></span>
        </div>
        {% for task in tasks %}
            <div class="health-tasks-row" data-task-row="{{ task.id }}">
                <span class="health-tasks-name">{{ task.name }}</span>
                <span class="health-tasks-state">{{ task.state }}</span>
                <span class="health-tasks-progress">{{ task.progress is not null ? task.progress ~ '%' : '-' }}</span>
                <span class="health-tasks-lastrun">
                    <strong>{{ task.lastRunStatus }}</strong>
                    {% if task.lastRunAt %}<small>{{ task.lastRunAt|date('Y-m-d H:i') }}</small>{% endif %}
                </span>
                {% if task.state == 'Running' %}
                    <button type="button" class="health-task-btn health-task-btn-stop" data-health-action="stop" data-health-id="{{ task.id }}">Stop</button>
                {% else %}
                    <button type="button" class="health-task-btn health-task-btn-run" data-health-action="trigger" data-health-id="{{ task.id }}">Run now</button>
                {% endif %}
            </div>
        {% else %}
            <div class="health-tasks-empty">No scheduled tasks reported.</div>
        {% endfor %}
    </div>
{% endblock %}

